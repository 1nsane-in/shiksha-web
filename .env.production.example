# Production Environment Variables for Render

# Database (Get from Render PostgreSQL Internal URL)
DATABASE_URL=postgresql://user:password@host.render.com:5432/dbname

# Authentication (Generate secure keys)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# API Configuration
NODE_ENV=production
PORT=10000
API_URL=https://your-app.onrender.com

# Supabase (Optional - if using for storage/auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Sentry (Optional - for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# PostHog (Optional - for analytics)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# Redis (Optional - if using external Redis)
# REDIS_URL=redis://user:password@host:port

# CORS (Update with your frontend URL)
CORS_ORIGIN=https://your-frontend.vercel.app

# File Upload (if using)
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Email (if using)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Payment Gateway (if using)
# RAZORPAY_KEY_ID=your-razorpay-key
# RAZORPAY_KEY_SECRET=your-razorpay-secret

# AI Service (if deployed separately)
# AI_SERVICE_URL=https://your-ai-service.onrender.com
