// ============================================
// Payment Schema
// ============================================

model Payment {
  id                    String                @id @default(uuid())
  studentId             String
  stage                 Int
  amount                Float
  currency              String                @default("INR")
  status                PaymentStatus         @default(PENDING)
  razorpayOrderId       String?
  razorpayPaymentId     String?
  razorpaySignature     String?
  paymentMethod         String?
  bankReference         String?
  manuallyApproved      Boolean               @default(false)
  approvedBy            String?
  approvalNote          String?
  paidAt                DateTime?
  refundAmount          Float?
  refundReason          String?
  refundedAt            DateTime?
  refundStatus          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  applicationId         String
  UniversityApplication UniversityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student               Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([applicationId])
  @@index([status])
  @@index([createdAt])
  @@index([studentId, status, createdAt]) // For payment history queries
  @@index([status, createdAt]) // For admin pending payments
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  MANUALLY_APPROVED
}
