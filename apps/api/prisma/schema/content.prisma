// ============================================
// Consultation & Gallery Schema
// ============================================

model Consultation {
  id                  String   @id
  name                String
  email               String
  phone               String
  neetScore           Int?
  state               String?
  country             String?
  preferredUniversity String?
  preferredIntake     String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime
}

model GalleryImage {
  id        String   @id
  title     String?
  url       String
  key       String
  type      String   @default("IMAGE") // IMAGE | VIDEO
  duration  Int?     // seconds, only for VIDEO
  createdAt DateTime @default(now())
  updatedAt DateTime
}
