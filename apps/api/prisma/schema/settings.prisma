// ============================================
// Settings & Configuration Schema
// ============================================

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  value             Json
  isActive          Boolean  @default(true)
  rolloutPercentage Int      @default(100)
  targetRoles       Json?
  targetUsers       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
