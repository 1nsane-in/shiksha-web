// ============================================
// Analytics & Logging Schema
// ============================================

model UserActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  deviceInfo Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PageView {
  id          String   @id @default(uuid())
  userId      String?
  sessionId   String
  path        String
  queryParams Json?
  referrer    String?
  deviceType  String?
  browser     String?
  os          String?
  duration    Int?
  bounced     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([path])
  @@index([createdAt])
}

model SearchHistory {
  id          String   @id @default(uuid())
  userId      String
  query       String
  filters     Json?
  resultCount Int?
  clicked     String?
  clickedId   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  category  String
  message   String
  metadata  Json?
  userId    String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entityType   String
  entityId     String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  changeReason String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model DailyMetric {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  metricType String
  value      Float
  count      Int      @default(1)
  metadata   Json?

  @@unique([date, metricType])
  @@index([date])
  @@index([metricType])
}

model StudentMetric {
  id               String    @id @default(uuid())
  studentId        String    @unique
  totalPayments    Float     @default(0)
  documentScore    Float     @default(0)
  completionRate   Float     @default(0)
  daysInSystem     Int       @default(0)
  lastCalculatedAt DateTime  @default(now())
  riskScore        Float?
  recommendations  Json?
  lastAIAnalysisAt DateTime?
}
