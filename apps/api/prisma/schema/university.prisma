// ============================================
// University Schema
// ============================================

model University {
  id                  String                    @id @default(uuid())
  name                String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  slug                String                    @unique
  shortName           String
  establishedYear     Int
  type                UniversityType
  website             String
  logo                String?
  bannerImage         String?
  status              UniversityStatus          @default(DRAFT)
  verifiedAt          DateTime?
  brochureUrl         String?
  studentDemographics Json?
  socialLinks         Json?
  academic            UniversityAcademic?
  admin               UniversityAdmin?
  admission           UniversityAdmission?
  applications        UniversityApplication[]
  contact             UniversityContact?
  content             UniversityContent?
  courses             UniversityCourse[]
  documents           UniversityDocument[]
  fees                UniversityFees?
  infrastructure      UniversityInfrastructure?
  location            UniversityLocation?
  recognition         UniversityRecognition?
  support               UniversitySupport?
  platformCourses     PlatformCourseUniversity[]
  exams               Exam[]

  @@index([slug])
  @@index([name])
  @@index([status])
}

model UniversityLocation {
  id           String     @id @default(uuid())
  universityId String     @unique
  country      String
  state        String
  city         String
  address      String
  latitude     Float?
  longitude    Float?
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  
  @@index([country])
}

model UniversityContact {
  id                   String     @id @default(uuid())
  universityId         String     @unique
  email                String
  phone                String
  admissionOfficeHours String
  university           University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityAcademic {
  id               String     @id @default(uuid())
  universityId     String     @unique
  duration         String
  medium           String
  specializations  String[]
  intakeMonths     String[]
  totalSeats       Int
  governmentSeats  Int
  managementSeats  Int
  nriSeats         Int
  curriculumType   String?
  clinicalTraining String?
  programs         Json       @default("[]") @db.Json
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityRecognition {
  id                         String      @id @default(uuid())
  universityId               String      @unique
  bodies                     String[]
  ecfmgStatus                ECFMGStatus
  naacGrade                  String?
  nbaAccredited              Boolean     @default(false)
  worldRank                  Int?
  nationalRank               Int?
  rankingSource              String?
  accreditations             String[]
  subjectRankings            Json?
  worldRankingSource         String?
  nationalRankingSource      String?
  otherRankingSource         String?
  otherNationalRankingSource String?
  university                 University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityFees {
  id                   String     @id @default(uuid())
  universityId         String     @unique
  tuitionAnnual        Float?
  totalProgram         Float?
  hostelAnnual         Float?
  registration         Float?
  examination          Float?
  library              Float?
  otherFees            Json?
  currency             String
  scholarshipAvailable Boolean    @default(false)
  scholarshipDetails   String?
  paymentSchedule      String
  refundPolicy         String
  feeHikePolicy        String?
  programBreakdown     Json?
  university           University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityInfrastructure {
  id             String     @id @default(uuid())
  universityId   String     @unique
  hospitalBeds   Int?
  librarySize    String?
  hostelBoys     Int
  hostelGirls    Int
  campusArea     Float?
  facilities     String[]
  cafeteria      Boolean    @default(false)
  wifiCampus     Boolean    @default(false)
  transportation Boolean    @default(false)
  departments    String[]   @default([])
  laboratories   String[]   @default([])
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityAdmission {
  id                  String     @id @default(uuid())
  universityId        String     @unique
  entranceExams       String[]
  minimumMarks        String?
  ageCriteria         String
  eligibility         String?
  programEligibility  Json?
  requiredDocuments   String[]
  applicationDeadline DateTime
  applicationFee      Float
  selectionProcess    String
  reservationPolicy   String?
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversitySupport {
  id                          String     @id @default(uuid())
  universityId                String     @unique
  placementRate               Float?
  averagePackage              Float?
  topRecruiters               String[]
  alumniNetwork               Boolean    @default(false)
  alumniCount                 Int?
  internationalStudentSupport Boolean    @default(false)
  visaAssistance              Boolean    @default(false)
  languageSupport             String[]
  counselingServices          Boolean    @default(false)
  careerGuidance              Boolean    @default(false)
  university                  University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityContent {
  id               String     @id @default(uuid())
  universityId     String     @unique
  shortDescription String
  longDescription  String
  highlights       String[]
  whyChooseUs      String?
  gallery          String[]
  virtualTour      String?
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityAdmin {
  id                    String     @id @default(uuid())
  universityId          String     @unique
  pocName               String
  pocDesignation        String
  pocEmail              String
  pocPhone              String?
  phoneCountryCode      String     @default("+91")
  phoneNumber           String     @default("")
  accountName           String
  accountNumber         String
  bankName              String
  bankBranch            String
  ifscCode              String
  gstNumber             String?
  panNumber             String?
  commission            Float
  recipientName         String?
  recipientBank         String?
  bankIdCode            String?
  recipientInn          String?
  recipientKpp          String?
  singleTreasuryAccount String?
  paymentPurpose        String?
  bankCountry           String?
  bankDetails           Json?
  university            University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityDocument {
  id           String            @id @default(uuid())
  universityId String
  type         UniversityDocType
  fileUrl      String
  fileName     String
  fileSize     Int
  uploadedAt   DateTime          @default(now())
  university   University        @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([type])
}

model UniversityCourse {
  id             String                  @id @default(uuid())
  universityId   String
  name           String
  duration       Int
  fees           Float
  currency       String                  @default("USD")
  eligibility    String?
  seats          Int?
  availableSeats Int?
  isActive       Boolean                 @default(true)
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  applications   UniversityApplication[]
  university     University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course         Course?                 @relation(fields: [courseId], references: [id])
  courseId       String?
}

model UniversityRequest {
  id               String                  @id @default(uuid())
  universityName   String
  country          String
  state            String?
  website          String?
  type             String
  programs         String[]
  otherPrograms    String?
  contactEmail     String
  contactPhone     String
  additionalInfo   String?
  status           UniversityRequestStatus @default(PENDING)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum UniversityType {
  GOVERNMENT
  PRIVATE
  DEEMED
  AUTONOMOUS
}

enum UniversityStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ECFMGStatus {
  APPROVED
  NOT_APPROVED
  PENDING
}

enum UniversityDocType {
  BROCHURE
  PROSPECTUS
  RECOGNITION_CERTIFICATE
  AFFILIATION_DOCUMENT
  DEGREE_SAMPLE
  FEE_STRUCTURE
  ADMISSION_FORM
  HOSTEL_RULES
  ANTI_RAGGING_POLICY
  AGREEMENT
}

enum UniversityRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ADDED
}
