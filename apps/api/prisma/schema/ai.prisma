// ============================================
// AI Module Schema
// ============================================

model AIJob {
  id              String             @id @default(uuid())
  studentId       String?
  documentId      String?
  jobType         AIJobType
  status          AIJobStatus        @default(PENDING)
  priority        Int                @default(5)
  input           Json
  output          Json?
  error           String?
  confidence      Float?
  flags           Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  retryCount      Int                @default(0)
  maxRetries      Int                @default(3)
  extractedFields AIExtractedField[]
  validationFlags AIFlag[]
  student         Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}

model AIExtractedField {
  id           String  @id @default(uuid())
  jobId        String
  fieldName    String
  value        String
  confidence   Float
  source       String?
  metadata     Json?
  validated    Boolean @default(false)
  correctValue String?
  correctedBy  String?
  job          AIJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AIFlag {
  id         String    @id @default(uuid())
  jobId      String
  type       String
  severity   String
  category   String
  message    String
  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  job        AIJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([severity])
}

model AIConversation {
  id        String                  @id @default(uuid())
  userId    String
  title     String?
  context   Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIConversationMessage[]

  @@index([userId])
}

model AIConversationMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIRecommendation {
  id         String   @id @default(uuid())
  studentId  String?
  type       String
  data       Json
  confidence Float
  reason     String?
  dismissed  Boolean  @default(false)
  applied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([studentId])
}

enum AIJobType {
  OCR_EXTRACT
  DOCUMENT_CLASSIFY
  DOCUMENT_VALIDATE
  FIELD_EXTRACT
  PROFILE_SUMMARY
  UNIVERSITY_RECOMMEND
  FRAUD_DETECT
  DUPLICATE_CHECK
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}
