// ============================================
// Visa Schema
// ============================================

model VisaCenter {
  id           String            @id @default(uuid())
  name         String
  address      String?
  city         String
  country      String
  contactNo    String?
  email        String?
  website      String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applications VisaApplication[]

  @@index([country])
}

model VisaChecklist {
  id           String            @id @default(uuid())
  country      String
  title        String
  description  String?
  documents    String[]
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applications VisaApplication[]
}

model VisaApplication {
  id              String                @id @default(uuid())
  studentId       String
  applicationId   String?
  visaCenterId    String?
  checklistId     String?
  status          VisaApplicationStatus @default(DRAFT)
  passportNumber  String?
  passportExpiry  DateTime?
  visaType        String?
  submissionDate  DateTime?
  appointmentDate DateTime?
  documentUrls    String[]
  remarks         String?
  notes           String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  checklist       VisaChecklist?        @relation(fields: [checklistId], references: [id])
  visaCenter      VisaCenter?           @relation(fields: [visaCenterId], references: [id])

  @@index([studentId])
  @@index([applicationId])
  @@index([status])
}

enum VisaApplicationStatus {
  DRAFT
  DOCUMENTS_PENDING
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
}
