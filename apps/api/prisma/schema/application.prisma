// ============================================
// Application & Admission Schema
// ============================================

model UniversityApplication {
  id               String                @id @default(uuid())
  studentId        String
  courseId         String?
  status           String                @default("pending")
  universityId     String
  createdAt        DateTime              @default(now())
  email            String?
  firstName        String?
  formData         Json?
  lastName         String?
  selectedProgram  String?
  submittedAt      DateTime?
  updatedAt        DateTime              @updatedAt
  admissionLetter  AdmissionLetter?
  timelineEvents   ApplicationTimeline[]
  examRecord       ExamRecord?
  invitationLetter InvitationLetter?
  Payment          Payment[]
  tickets          SupportTicket[]
  course           UniversityCourse?     @relation(fields: [courseId], references: [id])
  student          Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university       University            @relation(fields: [universityId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([universityId])
}

model ApplicationTimeline {
  id            String                @id @default(uuid())
  applicationId String
  studentId     String
  stage         Int
  event         String
  title         String
  description   String?
  metadata      Json?
  occurredAt    DateTime              @default(now())
  application   UniversityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([applicationId, stage])
  @@index([studentId])
  @@index([occurredAt])
}

model DocumentType {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  description      String?
  requiredForStage Int
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  ocrRequired      Boolean           @default(false)
  validationRules  Json?
  studentDocuments StudentDocument[]
}

model StageRequirement {
  id              String   @id @default(uuid())
  stage           Int
  description     String?
  documentTypeIds String[]
  paymentAmount   Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([stage, isActive])
  @@index([stage])
}

model StudentDocument {
  id               String         @id @default(uuid())
  studentId        String
  documentTypeId   String
  fileUrl          String
  fileName         String
  fileSize         Int
  mimeType         String?
  extractedData    Json?
  status           DocumentStatus @default(UPLOADED)
  remarks          String?
  verifiedBy       String?
  verifiedAt       DateTime?
  version          Int            @default(1)
  replacedBy       String?
  viewCount        Int            @default(0)
  lastViewedAt     DateTime?
  lastViewedBy     String?
  downloadCount    Int            @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  documentType     DocumentType   @relation(fields: [documentTypeId], references: [id])
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model AdmissionLetter {
  id            String                 @id @default(uuid())
  studentId     String                 @unique
  fileUrl       String
  fileName      String?
  uploadedBy    String
  uploadedAt    DateTime               @default(now())
  viewCount     Int                    @default(0)
  downloadCount Int                    @default(0)
  applicationId String?                @unique
  application   UniversityApplication? @relation(fields: [applicationId], references: [id])
  student       Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ExamRecord {
  id               String                @id @default(uuid())
  applicationId    String                @unique
  studentId        String
  examDate         DateTime?
  examSubject      String?
  examCenter       String?
  result           ExamResult?
  resultDeclaredAt DateTime?
  resultRemarks    String?
  attemptNumber    Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  application      UniversityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student          Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([applicationId])
}

model InvitationLetter {
  id               String                 @id @default(uuid())
  studentId        String                 @unique
  fileUrl          String
  fileName         String?
  uploadedBy       String
  isDownloadable   Boolean                @default(false)
  uploadedAt       DateTime               @default(now())
  viewCount        Int                    @default(0)
  downloadCount    Int                    @default(0)
  lastViewedAt     DateTime?
  lastDownloadedAt DateTime?
  applicationId    String?                @unique
  application      UniversityApplication? @relation(fields: [applicationId], references: [id])
  student          Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum DocumentStatus {
  UPLOADED
  IN_REVIEW
  PROCESSING
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

enum ExamResult {
  AWAITED
  PASSED
  FAILED
}
