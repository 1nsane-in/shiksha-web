// This file contains the Prisma schema for the Sections module
// It should be added to your existing schema.prisma file

model Section {
  id          String   @id @default(uuid())
  title       String
  description String
  courseId    String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@index([courseId])
  @@index([courseId, title], name: "courseId_title")
}