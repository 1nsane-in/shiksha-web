generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  passwordHash    String?
  name            String
  phone           String?
  role            Role                 @default(STUDENT)
  avatarUrl       String?
  isActive        Boolean              @default(true)
  emailVerified   Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastLoginAt     DateTime?
  lastLoginIp     String?
  aiConversations AIConversation[]
  notifications   Notification[]
  orgMemberships  OrganizationMember[]
  student         Student?
  activityLogs    UserActivityLog[]
  sessions        UserSession[]

  @@index([email])
  @@index([role])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Student {
  id                      String                  @id @default(uuid())
  userId                  String                  @unique
  fatherName              String?
  motherName              String?
  dob                     DateTime?
  gender                  String?
  address                 String?
  city                    String?
  state                   String?
  country                 String?
  pincode                 String?
  neetScore               Int?
  neetRank                Int?
  twelfthPercentage       Float?
  tenthPercentage         Float?
  currentStage            Int                     @default(1)
  applicationStatus       ApplicationStatus       @default(NOT_STARTED)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  aiJobs                  AIJob[]
  admissionLetter         AdmissionLetter?
  automationEvents        AutomationEvent[]
  invitationLetter        InvitationLetter?
  notificationPreferences NotificationPreference?
  payments                Payment[]
  stageHistories          StageHistory[]
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents               StudentDocument[]
  applications            UniversityApplication[]

  @@index([userId])
  @@index([applicationStatus])
  @@index([currentStage])
}

model StageHistory {
  id         String             @id @default(uuid())
  studentId  String
  fromStage  Int?
  toStage    Int
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  changedBy  String?
  changedAt  DateTime           @default(now())
  reason     String?
  metadata   Json?
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([changedAt])
}

model University {
  id              String                    @id @default(uuid())
  slug            String                    @unique
  name            String
  shortName       String
  establishedYear Int
  type            UniversityType
  website         String
  logo            String
  bannerImage     String
  status          UniversityStatus          @default(DRAFT)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  verifiedAt      DateTime?
  location        UniversityLocation?
  contact         UniversityContact?
  academic        UniversityAcademic?
  recognition     UniversityRecognition?
  fees            UniversityFees?
  infrastructure  UniversityInfrastructure?
  admission       UniversityAdmission?
  support         UniversitySupport?
  content         UniversityContent?
  admin           UniversityAdmin?
  courses         UniversityCourse[]
  applications    UniversityApplication[]
  documents       UniversityDocument[]

  @@index([slug])
  @@index([name])
  @@index([status])
}

model UniversityLocation {
  id           String     @id @default(uuid())
  universityId String     @unique
  country      String
  state        String
  city         String
  address      String
  latitude     Float?
  longitude    Float?
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityContact {
  id                   String     @id @default(uuid())
  universityId         String     @unique
  email                String
  phone                String
  admissionOfficeHours String
  university           University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityAcademic {
  id               String     @id @default(uuid())
  universityId     String     @unique
  programs         String[]
  duration         String
  medium           String
  specializations  String[]
  intakeMonths     String[]
  totalSeats       Int
  governmentSeats  Int
  managementSeats  Int
  nriSeats         Int
  curriculumType   String?
  clinicalTraining String?
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityRecognition {
  id             String      @id @default(uuid())
  universityId   String      @unique
  bodies         String[]
  ecfmgStatus    ECFMGStatus
  naacGrade      String?
  nbaAccredited  Boolean     @default(false)
  worldRank      Int?
  nationalRank   Int?
  accreditations String[]
  university     University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityFees {
  id                   String     @id @default(uuid())
  universityId         String     @unique
  tuitionAnnual        Float
  totalProgram         Float
  hostelAnnual         Float?
  registration         Float
  examination          Float?
  library              Float?
  otherFees            Json?
  currency             String
  scholarshipAvailable Boolean    @default(false)
  scholarshipDetails   String?
  paymentSchedule      String
  refundPolicy         String
  feeHikePolicy        String?
  university           University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityInfrastructure {
  id             String     @id @default(uuid())
  universityId   String     @unique
  hospitalBeds   Int
  departments    Int
  librarySize    String?
  hostelBoys     Int
  hostelGirls    Int
  laboratories   Int
  campusArea     Float?
  facilities     String[]
  cafeteria      Boolean    @default(false)
  wifiCampus     Boolean    @default(false)
  transportation Boolean    @default(false)
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityAdmission {
  id                  String     @id @default(uuid())
  universityId        String     @unique
  entranceExams       String[]
  minimumMarks        String
  ageCriteria         String
  eligibility         String
  requiredDocuments   String[]
  applicationDeadline DateTime
  applicationFee      Float
  selectionProcess    String
  reservationPolicy   String?
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversitySupport {
  id                          String     @id @default(uuid())
  universityId                String     @unique
  placementRate               Float?
  averagePackage              Float?
  topRecruiters               String[]
  alumniNetwork               Boolean    @default(false)
  alumniCount                 Int?
  internationalStudentSupport Boolean    @default(false)
  visaAssistance              Boolean    @default(false)
  languageSupport             String[]
  counselingServices          Boolean    @default(false)
  careerGuidance              Boolean    @default(false)
  university                  University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityContent {
  id               String     @id @default(uuid())
  universityId     String     @unique
  shortDescription String
  longDescription  String
  highlights       String[]
  whyChooseUs      String?
  gallery          String[]
  videoTour        String?
  virtualTour      String?
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityAdmin {
  id             String     @id @default(uuid())
  universityId   String     @unique
  pocName        String
  pocDesignation String
  pocEmail       String
  pocPhone       String
  accountName    String
  accountNumber  String
  bankName       String
  bankBranch     String
  ifscCode       String
  gstNumber      String?
  panNumber      String?
  commission     Float
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityDocument {
  id           String            @id @default(uuid())
  universityId String
  type         UniversityDocType
  fileUrl      String
  fileName     String
  fileSize     Int
  uploadedAt   DateTime          @default(now())
  university   University        @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([type])
}

model UniversityCourse {
  id             String                  @id @default(uuid())
  universityId   String
  name           String
  duration       Int
  fees           Float
  currency       String                  @default("USD")
  eligibility    String?
  seats          Int?
  availableSeats Int?
  isActive       Boolean                 @default(true)
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  applications   UniversityApplication[]
  university     University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model UniversityApplication {
  id                   String           @id @default(uuid())
  studentId            String
  courseId             String
  status               String           @default("pending")
  appliedAt            DateTime         @default(now())
  matchScore           Float?
  recommendedBy        String?
  recommendationReason String?
  assignedAgentId      String?
  course               UniversityCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student              Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university           University?      @relation(fields: [universityId], references: [id])
  universityId         String?

  @@index([studentId])
  @@index([status])
}

model DocumentType {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  description      String?
  requiredForStage Int
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  ocrRequired      Boolean           @default(false)
  validationRules  Json?
  studentDocuments StudentDocument[]
}

model StageRequirement {
  id              String   @id @default(uuid())
  stage           Int
  description     String?
  documentTypeIds String[]
  paymentAmount   Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([stage, isActive])
  @@index([stage])
}

model StudentDocument {
  id               String         @id @default(uuid())
  studentId        String
  documentTypeId   String
  fileUrl          String
  fileName         String
  fileSize         Int
  mimeType         String?
  extractedData    Json?
  status           DocumentStatus @default(UPLOADED)
  remarks          String?
  verifiedBy       String?
  verifiedAt       DateTime?
  version          Int            @default(1)
  replacedBy       String?
  viewCount        Int            @default(0)
  lastViewedAt     DateTime?
  lastViewedBy     String?
  downloadCount    Int            @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  documentType     DocumentType   @relation(fields: [documentTypeId], references: [id])
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())
  studentId         String
  stage             Int
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  bankReference     String?
  manuallyApproved  Boolean       @default(false)
  approvedBy        String?
  approvalNote      String?
  paidAt            DateTime?
  refundAmount      Float?
  refundReason      String?
  refundedAt        DateTime?
  refundStatus      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

model AdmissionLetter {
  id            String   @id @default(uuid())
  studentId     String   @unique
  fileUrl       String
  fileName      String?
  uploadedBy    String
  uploadedAt    DateTime @default(now())
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model InvitationLetter {
  id               String    @id @default(uuid())
  studentId        String    @unique
  fileUrl          String
  fileName         String?
  uploadedBy       String
  isDownloadable   Boolean   @default(false)
  uploadedAt       DateTime  @default(now())
  viewCount        Int       @default(0)
  downloadCount    Int       @default(0)
  lastViewedAt     DateTime?
  lastDownloadedAt DateTime?
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VisaCenter {
  id        String   @id @default(uuid())
  name      String
  address   String?
  city      String
  country   String
  contactNo String?
  email     String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
}

model VisaChecklist {
  id          String   @id @default(uuid())
  country     String
  title       String
  description String?
  documents   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country])
}

model AIJob {
  id              String             @id @default(uuid())
  studentId       String?
  documentId      String?
  jobType         AIJobType
  status          AIJobStatus        @default(PENDING)
  priority        Int                @default(5)
  input           Json
  output          Json?
  error           String?
  confidence      Float?
  flags           Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  retryCount      Int                @default(0)
  maxRetries      Int                @default(3)
  extractedFields AIExtractedField[]
  validationFlags AIFlag[]
  student         Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}

model AIExtractedField {
  id           String  @id @default(uuid())
  jobId        String
  fieldName    String
  value        String
  confidence   Float
  source       String?
  metadata     Json?
  validated    Boolean @default(false)
  correctValue String?
  correctedBy  String?
  job          AIJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AIFlag {
  id         String    @id @default(uuid())
  jobId      String
  type       String
  severity   String
  category   String
  message    String
  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  job        AIJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([severity])
}

model AutomationRule {
  id           String   @id @default(uuid())
  name         String
  description  String?
  trigger      String
  conditions   Json
  actions      Json
  priority     Int      @default(5)
  isActive     Boolean  @default(true)
  runCount     Int      @default(0)
  successCount Int      @default(0)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AutomationEvent {
  id          String    @id @default(uuid())
  ruleId      String?
  studentId   String?
  eventType   String
  payload     Json
  status      String    @default("pending")
  processedAt DateTime?
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  channels  Json?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  studentId        String   @unique
  emailEnabled     Boolean  @default(true)
  smsEnabled       Boolean  @default(false)
  pushEnabled      Boolean  @default(true)
  documentUpdates  Boolean  @default(true)
  paymentReminders Boolean  @default(true)
  stageChanges     Boolean  @default(true)
  announcements    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model UserActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  deviceInfo Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PageView {
  id          String   @id @default(uuid())
  userId      String?
  sessionId   String
  path        String
  queryParams Json?
  referrer    String?
  deviceType  String?
  browser     String?
  os          String?
  duration    Int?
  bounced     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([path])
  @@index([createdAt])
}

model SearchHistory {
  id          String   @id @default(uuid())
  userId      String
  query       String
  filters     Json?
  resultCount Int?
  clicked     String?
  clickedId   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  category  String
  message   String
  metadata  Json?
  userId    String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entityType   String
  entityId     String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  changeReason String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  value             Json
  isActive          Boolean  @default(true)
  rolloutPercentage Int      @default(100)
  targetRoles       Json?
  targetUsers       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model DailyMetric {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  metricType String
  value      Float
  count      Int      @default(1)
  metadata   Json?

  @@unique([date, metricType])
  @@index([date])
  @@index([metricType])
}

model StudentMetric {
  id               String    @id @default(uuid())
  studentId        String    @unique
  totalPayments    Float     @default(0)
  documentScore    Float     @default(0)
  completionRate   Float     @default(0)
  daysInSystem     Int       @default(0)
  lastCalculatedAt DateTime  @default(now())
  riskScore        Float?
  recommendations  Json?
  lastAIAnalysisAt DateTime?
}

model Organization {
  id                   String                   @id @default(uuid())
  name                 String
  slug                 String                   @unique
  logoUrl              String?
  plan                 Plan                     @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  maxStudents          Int                      @default(10)
  maxAdmins            Int                      @default(2)
  currentStudents      Int                      @default(0)
  currentAdmins        Int                      @default(0)
  customDomain         String?
  brandingColor        String?
  features             Json?
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  apiKeys              APIKey[]
  integrations         Integration[]
  invites              OrganizationInvitation[]
  members              OrganizationMember[]
  webhooks             WebhookEndpoint[]

  @@index([slug])
  @@index([stripeCustomerId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  permissions    Json?
  invitedBy      String?
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole      @default(MEMBER)
  token          String       @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  stripePriceId        String
  status               SubscriptionStatus
  plan                 Plan
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  seats                Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  subscriptionId  String?
  stripeInvoiceId String        @unique
  number          String?
  status          InvoiceStatus
  amountDue       Float
  amountPaid      Float
  currency        String        @default("USD")
  invoicePdf      String?
  invoiceUrl      String?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([organizationId])
  @@index([status])
}

model PricingPlan {
  id                   String   @id @default(uuid())
  name                 Plan     @unique
  displayName          String
  description          String?
  monthlyPrice         Float
  yearlyPrice          Float
  currency             String   @default("USD")
  features             Json
  limits               Json
  stripeMonthlyPriceId String?
  stripeYearlyPriceId  String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model APIKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  keyHash        String       @unique
  prefix         String
  permissions    Json?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
}

model WebhookEndpoint {
  id              String       @id @default(uuid())
  organizationId  String
  url             String
  secret          String
  events          String[]
  isActive        Boolean      @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id            String             @id @default(uuid())
  endpointId    String
  eventType     String
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  maxAttempts   Int                @default(5)
  responseCode  Int?
  responseError String?
  deliveredAt   DateTime?
  nextRetryAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([endpointId])
  @@index([status])
}

model Integration {
  id             String          @id @default(uuid())
  organizationId String
  type           IntegrationType
  name           String
  config         Json?
  credentials    Json?
  isActive       Boolean         @default(true)
  lastSyncAt     DateTime?
  syncError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

model TwoFactorAuth {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String
  backupCodes String[]
  verified    Boolean   @default(false)
  enabledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model SSOConnection {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  type             SSOType
  ssoUrl           String
  certificate      String
  entityId         String
  callbackUrl      String
  attributeMapping Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([organizationId])
}

model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  ipAddress     String
  success       Boolean
  failureReason String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

model AIConversation {
  id        String                  @id @default(uuid())
  userId    String
  title     String?
  context   Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIConversationMessage[]

  @@index([userId])
}

model AIConversationMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIRecommendation {
  id         String   @id @default(uuid())
  studentId  String?
  type       String
  data       Json
  confidence Float
  reason     String?
  dismissed  Boolean  @default(false)
  applied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model SupportTicket {
  id             String                 @id @default(uuid())
  organizationId String?
  userId         String
  subject        String
  description    String
  categoryId     String?
  priority       TicketPriority         @default(MEDIUM)
  status         TicketStatus           @default(OPEN)
  assignedTo     String?
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  messages       SupportTicketMessage[]

  @@index([userId])
  @@index([status])
}

model SupportTicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  senderId    String
  senderRole  String
  content     String
  attachments String[]
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Announcement {
  id             String    @id @default(uuid())
  organizationId String?
  title          String
  content        String
  type           String    @default("info")
  category       String?
  targetRoles    String[]
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

