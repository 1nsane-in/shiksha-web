generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================
// User & Auth
// ====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  name          String
  phone         String?
  role          Role     @default(STUDENT)
  avatarUrl     String?
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?
  lastLoginIp   String?

  student      Student?
  sessions     UserSession[]
  activityLogs UserActivityLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenHash    String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

// ====================
// Student Profile
// ====================

model Student {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fatherName        String?
  motherName        String?
  dob               DateTime?
  gender            String?
  address           String?
  city              String?
  state             String?
  country           String?
  pincode           String?

  neetScore         Int?
  neetRank          Int?
  twelfthPercentage Float?
  tenthPercentage   Float?

  currentStage      Int              @default(1)
  applicationStatus ApplicationStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    StudentDocument[]
  payments     Payment[]
  applications UniversityApplication[]
  
  // AI & Automation relations
  aiJobs       AIJob[]
  automationEvents AutomationEvent[]
  notificationPreferences NotificationPreference[]
  
  // Activity tracking
  stageHistories StageHistory[]

  @@index([userId])
  @@index([applicationStatus])
  @@index([currentStage])
}

model StageHistory {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  fromStage   Int?
  toStage     Int
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus
  
  changedBy   String?
  changedAt   DateTime @default(now())
  reason      String?
  metadata    Json?
  
  @@index([studentId])
  @@index([changedAt])
}

enum ApplicationStatus {
  NOT_STARTED
  STAGE_1_PENDING
  STAGE_1_IN_REVIEW
  STAGE_1_APPROVED
  STAGE_2_PENDING
  STAGE_2_IN_REVIEW
  STAGE_2_APPROVED
  STAGE_3_ACTIVE
  STAGE_4_PENDING
  STAGE_4_APPROVED
  STAGE_5_UNLOCKED
  COMPLETED
  REJECTED
}

// ====================
// Universities
// ====================

model University {
  id          String   @id @default(uuid())
  name        String
  country     String
  city        String?
  description String?
  website     String?
  logoUrl     String?
  ranking     Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  metadata    Json? // For AI enrichment

  courses UniversityCourse[]

  @@index([country])
  @@index([name])
}

model UniversityCourse {
  id           String    @id @default(uuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name         String
  duration     Int
  fees         Float
  currency     String   @default("USD")
  eligibility  String?
  seats        Int?
  availableSeats Int?
  isActive     Boolean  @default(true)
  
  metadata     Json? // For AI: curriculum, specializations, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications UniversityApplication[]
}

model UniversityApplication {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     UniversityCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status     String   @default("pending")
  appliedAt  DateTime @default(now())
  
  // AI recommendation data
  matchScore Float?
  recommendedBy String?
  recommendationReason String?
  
  // Agent assignment
  assignedAgentId String?

  @@index([studentId])
  @@index([status])
}

// ====================
// Documents
// ====================

model DocumentType {
  id                String   @id @default(uuid())
  name              String
  code              String   @unique
  description       String?
  requiredForStage  Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  
  // AI processing config
  ocrRequired      Boolean  @default(false)
  validationRules  Json?

  studentDocuments StudentDocument[]
}

model StudentDocument {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String?
  
  // Metadata extracted
  extractedData  Json?
  
  status         DocumentStatus @default(UPLOADED)
  remarks        String?
  verifiedBy     String?
  verifiedAt     DateTime?
  
  // Version control
  version        Int      @default(1)
  replacedBy     String?
  
  // Access tracking
  viewCount      Int      @default(0)
  lastViewedAt   DateTime?
  lastViewedBy   String?
  downloadCount  Int      @default(0)
  lastDownloadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

enum DocumentStatus {
  UPLOADED
  IN_REVIEW
  PROCESSING
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

// ====================
// Payments
// ====================

model Payment {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  stage             Int
  amount            Float
  currency          String   @default("INR")

  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature  String?
  
  // Payment method
  paymentMethod     String?
  bankReference     String?
  
  // Manual approval
  manuallyApproved   Boolean  @default(false)
  approvedBy        String?
  approvalNote      String?

  paidAt DateTime?
  
  // Refund tracking
  refundAmount      Float?
  refundReason      String?
  refundedAt        DateTime?
  refundStatus      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  MANUALLY_APPROVED
}

// ====================
// Letters
// ====================

model AdmissionLetter {
  id         String   @id @default(uuid())
  studentId  String   @unique
  fileUrl    String
  fileName   String?
  uploadedBy String
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Access tracking
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
}

model InvitationLetter {
  id              String   @id @default(uuid())
  studentId       String   @unique
  fileUrl         String
  fileName        String?
  uploadedBy      String
  isDownloadable  Boolean  @default(false)
  uploadedAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Access tracking
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
  lastViewedAt  DateTime?
  lastDownloadedAt DateTime?
}

// ====================
// Visa Support
// ====================

model VisaCenter {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String
  country     String
  contactNo   String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([country])
}

model VisaChecklist {
  id          String   @id @default(uuid())
  country     String
  title       String
  description String?
  documents   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([country])
}

// ====================
// AI & Automation
// ====================

model AIJob {
  id            String   @id @default(uuid())
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentId    String?
  
  jobType       AIJobType
  status        AIJobStatus @default(PENDING)
  priority      Int      @default(5)
  
  input         Json
  output        Json?
  error         String?
  
  confidence    Float?
  flags         Json?
  
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // For automation
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}

enum AIJobType {
  OCR_EXTRACT
  DOCUMENT_CLASSIFY
  DOCUMENT_VALIDATE
  FIELD_EXTRACT
  PROFILE_SUMMARY
  UNIVERSITY_RECOMMEND
  FRAUD_DETECT
  DUPLICATE_CHECK
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model AIExtractedField {
  id        String   @id @default(uuid())
  jobId     String
  job       AIJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  fieldName String
  value     String
  confidence Float
  
  source    String? // page, region, etc.
  metadata  Json?
  
  validated Boolean @default(false)
  correctValue String?
  correctedBy String?
  
  @@index([jobId])
}

model AIFlag {
  id          String   @id @default(uuid())
  jobId       String
  job         AIJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  type        String
  severity    String   // low, medium, high, critical
  category    String
  message     String
  
  resolved    Boolean @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([jobId])
  @@index([severity])
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String   // event type
  conditions  Json
  actions     Json
  
  priority    Int      @default(5)
  isActive    Boolean  @default(true)
  
  runCount    Int      @default(0)
  successCount Int     @default(0)
  failureCount Int     @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AutomationEvent {
  id          String   @id @default(uuid())
  ruleId      String?
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  eventType   String
  payload     Json
  
  status      String   @default("pending")
  processedAt  DateTime?
  result      Json?
  error       String?
  
  createdAt   DateTime @default(now())
  
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

// ====================
// Notifications
// ====================

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String
  title       String
  message     String
  data        Json?
  
  isRead      Boolean @default(false)
  readAt      DateTime?
  
  channels    Json? // { email: false, sms: true, push: true }
  sentAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  pushEnabled     Boolean @default(true)
  
  documentUpdates Boolean @default(true)
  paymentReminders Boolean @default(true)
  stageChanges    Boolean @default(true)
  announcements   Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// User Activity Logging
// ====================

model UserActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action      String
  entityType  String?
  entityId    String?
  
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  deviceInfo  Json?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PageView {
  id          String   @id @default(uuid())
  userId      String?
  sessionId   String
  
  path        String
  queryParams Json?
  referrer    String?
  
  deviceType  String?
  browser     String?
  os          String?
  
  duration    Int? // seconds
  bounced     Boolean @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([path])
  @@index([createdAt])
}

// ====================
// Search & Query History
// ====================

model SearchHistory {
  id          String   @id @default(uuid())
  userId      String
  
  query       String
  filters     Json?
  resultCount Int?
  
  clicked     String? // entity type that was clicked
  clickedId   String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// ====================
// System Logs
// ====================

model SystemLog {
  id          String   @id @default(uuid())
  level       String   // info, warn, error
  category    String   // auth, payment, document, ai
  
  message     String
  metadata    Json?
  
  userId      String?
  requestId   String?
  
  createdAt   DateTime @default(now())
  
  @@index([level])
  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  
  oldValue   Json?
  newValue   Json?
  
  ipAddress  String?
  userAgent  String?
  
  changeReason String?
  
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ====================
// Feature Flags & Config
// ====================

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  value       Json
  isActive    Boolean  @default(true)
  
  // Rollout
  rolloutPercentage Int  @default(100)
  targetRoles Json?
  targetUsers  Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ====================
// Analytics Aggregations
// ====================

model DailyMetric {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  metricType  String
  value       Float
  count       Int       @default(1)
  
  metadata    Json?
  
  @@unique([date, metricType])
  @@index([date])
  @@index([metricType])
}

model StudentMetric {
  id          String   @id @default(uuid())
  studentId   String
  
  // Calculated metrics
  totalPayments   Float @default(0)
  documentScore    Float @default(0)
  completionRate   Float @default(0)
  daysInSystem     Int   @default(0)
  
  lastCalculatedAt DateTime @default(now())
  
  // AI-generated insights
  riskScore    Float?
  recommendations Json?
  lastAIAnalysisAt DateTime?
  
  @@unique([studentId])
}
